{
  "_about": "Take restoration contract: what a dropped asset's provenance resolves to, and the geometry it restores. Read by tests/test_take_restoration.py against server/take_placement.py; a browser mirror is held to the same table. Expected values were worked by hand from the plan's rules, not generated by the code under test.",
  "params": {
    "base": {
      "take_placement_policy": "authored_v1", "placement_fps": 24, "scene_id": "s1",
      "selection_start": 20, "selection_end": 33,
      "actual_pre_context_frames": 17, "actual_post_context_frames": 0,
      "requested_mask_pre_offset": 0, "requested_mask_post_offset": 0,
      "frame_count_padding": 0, "take_placement_mode": "trimmed", "take_keep_padding": false
    },
    "offsets": {
      "take_placement_policy": "authored_v1", "placement_fps": 24, "scene_id": "s1",
      "selection_start": 20, "selection_end": 33,
      "actual_pre_context_frames": 17, "actual_post_context_frames": 8,
      "requested_mask_pre_offset": 2, "requested_mask_post_offset": 3,
      "frame_count_padding": 4, "frame_count": 42, "mask_end_frame": 38,
      "take_placement_mode": "trimmed", "take_keep_padding": false
    },
    "export": {
      "take_placement_policy": "authored_v1", "take_keep_padding": false, "placement_fps": 30,
      "editor_export": {"scene_id": "s1", "range": {"start": 50, "end": 80}, "fps": 30}
    }
  },
  "sources": [
    {"name": "a marked Save Video take", "params": "base", "asset_type": "video",
     "expect": {"status": "supported", "scene_id": "s1", "placement_fps": 24}},
    {"name": "a marked export take", "params": "export", "asset_type": "video",
     "expect": {"status": "supported", "scene_id": "s1", "placement_fps": 30}},
    {"name": "take audio carries its encoded count", "params": "base", "asset_type": "audio",
     "override": {"encoded_frame_count": 40},
     "expect": {"status": "supported", "scene_id": "s1", "placement_fps": 24, "encoded_frame_count": 40}},
    {"name": "take audio without an encoded count", "params": "base", "asset_type": "audio",
     "expect": {"status": "unavailable", "reason": "incomplete"}},
    {"name": "a legacy Save Video take", "params": "base", "asset_type": "video",
     "remove": ["take_placement_policy", "placement_fps"],
     "expect": {"status": "legacy", "reason": "legacy"}},
    {"name": "a legacy take keeps no clock even with a file fps", "params": "base", "asset_type": "video",
     "remove": ["take_placement_policy", "placement_fps"], "override": {"fps": 24},
     "expect": {"status": "legacy", "reason": "legacy"}},
    {"name": "an unknown policy", "params": "base", "asset_type": "video",
     "override": {"take_placement_policy": "authored_v9"},
     "expect": {"status": "unavailable", "reason": "unsupported_policy"}},
    {"name": "a marked take without placement fps", "params": "base", "asset_type": "video",
     "remove": ["placement_fps"],
     "expect": {"status": "unavailable", "reason": "missing_fps"}},
    {"name": "a zero placement fps", "params": "base", "asset_type": "video",
     "override": {"placement_fps": 0},
     "expect": {"status": "unavailable", "reason": "missing_fps"}},
    {"name": "an empty selection", "params": "base", "asset_type": "video",
     "override": {"selection_end": 20},
     "expect": {"status": "unavailable", "reason": "incomplete"}},
    {"name": "a fractional selection is not a record", "params": "base", "asset_type": "video",
     "override": {"selection_start": 20.9},
     "expect": {"status": "unavailable", "reason": "incomplete"}},
    {"name": "an export that was not placed as a take", "params": "export", "asset_type": "video",
     "remove": ["take_placement_policy", "placement_fps", "take_keep_padding"],
     "expect": {"status": "not_take"}},
    {"name": "an imported asset", "params": {}, "asset_type": "video",
     "expect": {"status": "not_take"}},
    {"name": "an image", "params": "base", "asset_type": "image",
     "expect": {"status": "not_take"}}
  ],
  "geometry": [
    {"name": "same scene, same fps: original time and trim", "params": "base", "encoded": 40,
     "same_scene": true, "fps": 24, "cursor": 500,
     "expect": [17, 30, 40, 20, 33]},
    {"name": "same scene 24 to 30 keeps one converted duration (plan pin)", "params": "base", "encoded": 40,
     "same_scene": true, "fps": 30, "cursor": 500,
     "expect": [21, 38, 50, 25, 42]},
    {"name": "fractional 23.976 to 29.97", "params": "base", "override": {"placement_fps": 23.976},
     "encoded": 40, "same_scene": true, "fps": 29.97, "cursor": 500,
     "expect": [21, 38, 50, 25, 42]},
    {"name": "exact NTSC 24000/1001 to 30000/1001 rounds the source end down (ratio 1.2499999999999998)",
     "params": "base", "override": {"placement_fps": 23.976023976023978},
     "encoded": 40, "same_scene": true, "fps": 29.97002997002997, "cursor": 500,
     "expect": [21, 37, 50, 25, 41]},
    {"name": "Python int() coercion: floats truncate, null is zero, a string true is not true",
     "params": "offsets",
     "override": {"actual_pre_context_frames": 17.9, "requested_mask_pre_offset": null,
                  "take_keep_padding": "true", "mask_end_frame": 42},
     "encoded": 42, "same_scene": true, "fps": 24, "cursor": 0,
     "expect": [17, 33, 38, 20, 36]},
    {"name": "same scene 30 to 24", "params": "base", "override": {"placement_fps": 30}, "encoded": 40,
     "same_scene": true, "fps": 24, "cursor": 500,
     "expect": [14, 24, 32, 16, 26]},
    {"name": "another scene places the saved trim at the cursor", "params": "base", "encoded": 40,
     "same_scene": false, "fps": 24, "cursor": 7,
     "expect": [17, 30, 40, 7, 20]},
    {"name": "another scene at another fps", "params": "base", "encoded": 40,
     "same_scene": false, "fps": 30, "cursor": 100,
     "expect": [21, 38, 50, 100, 117]},
    {"name": "requested offsets bounded by context, padding removed", "params": "offsets", "encoded": 42,
     "same_scene": true, "fps": 24, "cursor": 0,
     "expect": [15, 33, 38, 18, 36]},
    {"name": "saved settings win over today's: kept padding", "params": "offsets",
     "override": {"take_keep_padding": true, "mask_end_frame": 42}, "encoded": 42,
     "same_scene": true, "fps": 24, "cursor": 0,
     "expect": [15, 42, 42, 18, 45]},
    {"name": "untrimmed take", "params": "offsets", "override": {"take_placement_mode": "untrimmed"},
     "encoded": 42, "same_scene": true, "fps": 24, "cursor": 0,
     "expect": [0, 38, 38, 3, 41]},
    {"name": "export take", "params": "export", "encoded": 30,
     "same_scene": true, "fps": 30, "cursor": 0,
     "expect": [0, 30, 30, 50, 80]},
    {"name": "export take into a 24 fps retime of its scene", "params": "export", "encoded": 30,
     "same_scene": true, "fps": 24, "cursor": 0,
     "expect": [0, 24, 24, 40, 64]},
    {"name": "a one-frame take that collapses keeps one frame", "params": "base",
     "override": {"placement_fps": 30, "selection_start": 20, "selection_end": 21,
                  "actual_pre_context_frames": 0},
     "encoded": 3, "same_scene": true, "fps": 12, "cursor": 0,
     "expect": [0, 1, 1, 8, 9]},
    {"name": "no source frame left after conversion", "params": "base",
     "override": {"placement_fps": 30, "selection_start": 20, "selection_end": 21,
                  "actual_pre_context_frames": 0},
     "encoded": 1, "same_scene": true, "fps": 12, "cursor": 0,
     "reason": "collapsed"},
    {"name": "an original start before the scene", "params": "base",
     "override": {"take_placement_mode": "untrimmed", "selection_start": 2, "selection_end": 10,
                  "actual_pre_context_frames": 5},
     "encoded": 13, "same_scene": true, "fps": 24, "cursor": 0,
     "reason": "before_scene_start"},
    {"name": "the same take at a cursor in another scene", "params": "base",
     "override": {"take_placement_mode": "untrimmed", "selection_start": 2, "selection_end": 10,
                  "actual_pre_context_frames": 5},
     "encoded": 13, "same_scene": false, "fps": 24, "cursor": 0,
     "expect": [0, 13, 13, 0, 13]},
    {"name": "a source with no frames in its range", "params": "base",
     "override": {"actual_pre_context_frames": 50}, "encoded": 10,
     "same_scene": true, "fps": 24, "cursor": 0,
     "reason": "empty"}
  ]
}
